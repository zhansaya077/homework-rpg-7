package com.narxoz.rpg.engine;

import com.narxoz.rpg.combatant.DungeonBoss;
import com.narxoz.rpg.combatant.Hero;
import com.narxoz.rpg.observer.*;

import java.util.Iterator;
import java.util.List;

public class DungeonEngine {

    private final int MAX_ROUNDS = 20;

    public EncounterResult runEncounter(List<Hero> heroes, DungeonBoss boss) {

        int round = 0;

        while (round < MAX_ROUNDS && boss.isAlive() && hasAliveHeroes(heroes)) {

            round++;
            System.out.println("\n===== ROUND " + round + " =====");

            for (Hero hero : heroes) {

                if (!hero.isAlive()) continue;

                int damage = hero.attack();
                boss.takeDamage(damage);

                boss.notifyObservers(new GameEvent(
                        GameEventType.ATTACK_LANDED,
                        hero.getName(),
                        damage
                ));

                if (!boss.isAlive()) break;
            }

            if (!boss.isAlive()) break;

            for (Hero hero : heroes) {

                if (!hero.isAlive()) continue;

                int damage = boss.attack();
                hero.takeDamage(damage);

                boss.notifyObservers(new GameEvent(
                        GameEventType.ATTACK_LANDED,
                        boss.getName(),
                        damage
                ));

               
                if (hero.isAlive() && hero.isLowHp()) {
                    boss.notifyObservers(new GameEvent(
                            GameEventType.HERO_LOW_HP,
                            hero.getName(),
                            hero.getHp()
                    ));
                }

               
                if (!hero.isAlive()) {
                    boss.notifyObservers(new GameEvent(
                            GameEventType.HERO_DIED,
                            hero.getName(),
                            0
                    ));
                }
            }
        }

        boolean heroesWon = boss.isAlive() == false;

        int aliveCount = 0;
        for (Hero h : heroes) {
            if (h.isAlive()) aliveCount++;
        }

        return new EncounterResult(heroesWon, round, aliveCount);
    }

    private boolean hasAliveHeroes(List<Hero> heroes) {
        for (Hero h : heroes) {
            if (h.isAlive()) return true;
        }
        return false;
    }
}
